app:
  name: Gemini Web API

server:
  host: 0.0.0.0
  port: 8000

security:
  # Leave empty for local testing. Set GWA_API_KEYS or list keys here for production.
  api_keys: []
  cors_origins:
    - "*"
  rate_limit_per_minute: 120

gemini:
  default_model: gemini-2.5-pro
  models:
    - gemini-2.5-pro
    - gemini-2.5-flash
    - gemini-2.0-flash
    - gemini-1.5-pro
  cookies_dir: cookies
  upload_dir: uploads
  request_timeout_seconds: 60
  close_delay_seconds: 300
  auto_refresh: true
  temporary_chat: true
  # Prefer mounting JSON cookie files into cookies/ for Docker.
  cookies:
    # - id: personal
    #   secure_1psid: "__Secure-1PSID value"
    #   secure_1psidts: "__Secure-1PSIDTS value, if present"
    #   proxy: null
    #   enabled: true
